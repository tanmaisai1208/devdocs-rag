# Add your own Google AI Studio / Gemini API key for answer generation.
# Keep this file as a template; never commit your real .env file.
GOOGLE_API_KEY=your_google_api_key_here

# Alternatively, use GEMINI_API_KEY instead of GOOGLE_API_KEY.
# GEMINI_API_KEY=

# Optional: set RAG_API_URL only if the Streamlit UI should call a non-default API URL.
# RAG_API_URL=http://127.0.0.1:8000
